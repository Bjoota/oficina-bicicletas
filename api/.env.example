# Copie este arquivo para .env e preencha com as credenciais reais.
# NUNCA versionar o .env.

# String de conexão do PostgreSQL remoto (Neon, Supabase, Railway, RDS etc.)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

# Defina "true" apenas se o provedor exigir SSL e o certificado não for validável
# pelo pool padrão do node-postgres.
DATABASE_SSL=false

# Porta HTTP da API
PORT=3000
